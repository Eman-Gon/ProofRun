# ProofRun: DuploCloud interface, OpenRouter repair proposals, Crusoe worker hosting.
# Copy to an ignored .env for local setup; see README.md for loading instructions.
# Keep credentials server-side, outside browser data and test containers.

# OpenRouter: required for generated repairs; comparison-only runs need no model.
OPENROUTER_API_KEY=
# Explicit provider/model ID; no default or fallback model.
PROOFRUN_MODEL=

# DuploCloud backend connection to the worker.
# A local DevKit container uses http://host.docker.internal:8766 instead.
PROOFRUN_WORKER_URL=http://127.0.0.1:8766
# Required shared bearer secret, 32-512 characters. See README.md for generation.
PROOFRUN_WORKER_TOKEN=

# Worker evidence and execution identity.
PROOFRUN_ARTIFACT_DIR=.commit-watch/proofrun
PROOFRUN_EXECUTION_TARGET=local
PROOFRUN_WORKER_ID=local-worker

# Selected additions: Similarweb customer context and BAND repair coordination.
# Similarweb requests use API credits only after the explicit research action.
SIMILARWEB_API_KEY=
# BAND stays disabled until both registered agents and their shared room are ready.
# Enabled BAND must finish the handoff; it never falls back to direct verification.
PROOFRUN_BAND_ENABLED=false
BAND_ROOM_ID=
BAND_PROPOSER_AGENT_ID=
BAND_PROPOSER_API_KEY=
BAND_VERIFIER_AGENT_ID=
BAND_VERIFIER_API_KEY=
PROOFRUN_BAND_TIMEOUT_SECONDS=240

# DuploCloud account/license/model setup lives in its separate DevKit configuration.
# For Crusoe, use deploy/crusoe/worker.env.example and record the actual VM identity.
