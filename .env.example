GROQ_API_KEY=
GITHUB_TOKEN=
TARGET_REPO=Eman-Gon/fp-multimodel
# Upgrade-demo memory: local or cloud. Cloud never falls back to local.
COGNEE_MEMORY_BACKEND=local
# For cloud, copy the tenant HTTPS URL from Cognee Cloud > API Keys.
COGNEE_API_URL=
COGNEE_API_KEY=
# Optional tenant header, also shown under Connection Details.
COGNEE_TENANT_ID=
# Enables bounded upstream searches for changed dependencies through Bright Data MCP.
# Missing credentials are shown in the report; the core review still runs.
BRIGHTDATA_API_KEY=

# Match the image and command to your target before running tests.
SANDBOX_IMAGE=commit-watch-sandbox:latest
TEST_COMMAND="python -m pytest -q -p no:cacheprovider && npm test"
TEST_TIMEOUT=60
BASELINE_COUNT=35
