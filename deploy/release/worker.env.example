# Private server configuration. This is not a working credential file.
# EnvironmentFile format: KEY=value; no shell substitutions.
# The Python entry point does not automatically load .env files.

# Same server-side authentication variable used by the fixture worker.
# Supply the same secret to this release worker and its authorized backend/CI callers.
# At least 32 printable, non-whitespace characters; never expose it to the browser.
PROOFRUN_WORKER_TOKEN=
PROOFRUN_RELEASE_TARGETS=/etc/proofrun/release-targets.json
PROOFRUN_RELEASE_ARTIFACT_DIR=/var/lib/proofrun/releases

# Required for live investigation, including when repair=false.
# Use an explicit provider/model identifier; auto/free routing is not accepted.
OPENROUTER_API_KEY=
PROOFRUN_MODEL=

# Set this on the DuploCloud C# backend, not in browser/frontend configuration.
# Use a private URL reachable from that backend; loopback assumes the same host.
# The release listener defaults to 8767; the existing fixture worker uses 8766.
PROOFRUN_RELEASE_WORKER_URL=http://127.0.0.1:8767

# Optional: only needed if a target's staging.headers_env names this variable.
# Value must include the full header value, for example "Bearer <secret>".
# Do not enable staging writes without dedicated synthetic data and explicit scope.
PROOFRUN_STAGING_AUTHORIZATION=
