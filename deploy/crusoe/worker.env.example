# Installed privately at /etc/proofrun/worker.env (root:proofrun, mode 0640).
# systemd EnvironmentFile format: KEY=value. Do not use shell substitutions.
PROOFRUN_WORKER_TOKEN=
PROOFRUN_ARTIFACT_DIR=/var/lib/proofrun/artifacts
PROOFRUN_EXECUTION_TARGET=crusoe
# Use the real VM identity, not a generic label, once checked against Crusoe.
PROOFRUN_WORKER_ID=
# Required only for generated repair. Missing values must mean unavailable.
OPENROUTER_API_KEY=
PROOFRUN_MODEL=
